{
  "expo": {
    "name": "NextDoorLearn",
    "slug": "nextdoorlearn",
    "owner": "peternjo",
    "version": "1.0.0",
    "runtimeVersion": { "policy": "appVersion" },
    "orientation": "portrait",
    "icon": "./assets/images/nextdoorlearn-icon.png",
    "scheme": "nextdoorlearn",
    "userInterfaceStyle": "light",
    "primaryColor": "#0F766E",
    "description": "Affordable, human tutoring that connects students with volunteer and low-cost tutors.",
    "ios": {
      "bundleIdentifier": "com.peternjoroge.nextdoorlearn",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a profile picture for your NextDoorLearn profile or tutor application.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.peternjoroge.nextdoorlearn",
      "versionCode": 1,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nextdoorlearn-icon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "backgroundColor": "#F7F4EE", "image": "./assets/images/nextdoorlearn-icon.png", "imageWidth": 150 }],
      ["expo-secure-store", { "configureAndroidBackup": true, "faceIDPermission": "Allow NextDoorLearn to securely access your saved session." }],
      ["expo-image-picker", { "photosPermission": "Choose a profile picture for your NextDoorLearn profile or tutor application.", "cameraPermission": false }],
      ["expo-notifications", { "icon": "./assets/images/android-icon-monochrome.png", "color": "#0F766E", "defaultChannel": "default" }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://nextdoorlearn-backend.onrender.com/api"
    }
  }
}
