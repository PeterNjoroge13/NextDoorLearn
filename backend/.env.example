NODE_ENV=development
PORT=3001
JWT_SECRET=change-this-to-a-long-random-secret
FIELD_ENCRYPTION_KEY=change-this-to-a-second-long-random-secret
DATABASE_PATH=./src/db/nextdoorlearn.db
# Optional: when set, PostgreSQL replaces SQLite automatically.
# Use the pooled Neon connection string in deployed environments.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=10
UPLOAD_DIR=./uploads

# Comma-separated browser origins allowed to call the API.
# Development automatically permits localhost and 127.0.0.1 on any port.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://127.0.0.1:5173
# Optional comma-separated JavaScript regex patterns for additional origins.
# Production permits only explicit origins and patterns.
CORS_ORIGIN_PATTERNS=

# Requests per 15 minutes.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
PUBLIC_FORM_RATE_LIMIT_MAX=15
ADMIN_EMAILS=

# Optional Google Calendar OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback

# Optional transactional email via Resend.
RESEND_API_KEY=
EMAIL_FROM=NextDoorLearn <no-reply@example.com>
RESEND_WEBHOOK_SECRET=
JOB_SECRET=
REQUIRE_EMAIL_VERIFICATION=false
ALLOW_DIRECT_TUTOR_REGISTRATION=false
